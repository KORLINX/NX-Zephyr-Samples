/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition_uf2_sdv6.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include "nx40_nrf52840-pinctrl.dtsi"

/ {
	model = "Korlinx NX nRF52840";
	compatible = "korlinx,nx40";

	leds {
		compatible = "gpio-leds";

		led_red: led_0 {
			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};

		led_blue: led_1 {
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};

		led_green: led_2 {
			gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		led_run: led_3 {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "Run LED";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button1: button_1 {
			gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 1";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &led_red;
		led1 = &led_blue;
		led2 = &led_green;
		led3 = &led_run;
		sw0 = &button1;
		dht0 = &shtc3;
		watchdog0 = &wdt0;
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

&uicr {
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio0 {
	status = "okay";

	lsm6dsl_cs_hog {
		gpio-hog;
		gpios = <17 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	shtc3: shtc3@70 {
		compatible = "sensirion,shtc3", "sensirion,shtcx";
		status = "okay";
		reg = <0x70>;
		measure-mode = "normal";
		clock-stretching;
	};

	lsm6dsl: lsm6dsl@6a {
		compatible = "st,lsm6dsl";
		status = "okay";
		reg = <0x6a>;
		irq-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
	};
};

&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	ext_flash: p25q32su@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		writeoc = "pp4o";
		readoc = "read4io";
		quad-enable-requirements = "S2B1v1";
		sck-frequency = <24000000>;
		jedec-id = [85 60 16];
		size = <33554432>;
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd = <8000>;
		sfdp-bfp = [
			e5 20 f9 ff  ff ff ff 01  44 eb 08 6b  08 3b 80 bb
			fe ff ff ff  ff ff 00 ff  ff ff 44 eb  0c 20 0f 52
			10 d8 08 81  ff ff ff ff  ff ff ff ff  ff ff ff ff
			ff ff ff ff  ff ff ff ff  00 00 20 00  ff ff ff ff
		];
	};
};

dmic_dev: &pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default>;
	pinctrl-names = "default";
	clock-source = "PCLK32M_HFXO";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	vbat_channel: channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};

#include <../boards/common/usb/cdc_acm_serial.dtsi>
